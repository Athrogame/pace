# Copy to .env (never commit .env). Without a key, the coach uses its built-in fallback messages.
AI_API_KEY=your-anthropic-api-key
# Optional: turns on "Continue with Google". Create one at console.cloud.google.com (see README).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: which Claude model writes coach messages
AI_MODEL=claude-opus-5-5
# Optional durable PostgreSQL connection. Use Supabase's Session pooler URL here, not in frontend code.
# PACE_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER-HOST:5432/postgres
# Public support/privacy contact shown in the Terms and Privacy Policy.
# PACE_CONTACT_EMAIL=you@example.com
# For under-13 parent email approval. Production requires all of these.
# PACE_REQUIRE_AGE_GATE=1
# PACE_AGE_GATE_SECRET=replace-with-at-least-32-random-characters
# PACE_PUBLIC_URL=https://your-pace-site.example
# PACE_BREVO_API_KEY=your-brevo-api-key
# PACE_BREVO_SENDER=your-verified-sender@example.com
